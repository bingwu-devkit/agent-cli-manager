{
  "name": "agent-cli-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Agent CLI Manager 开发工作区",
  "license": "MIT",
  "author": "BINGWU2003",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm knip && turbo run typecheck test build",
    "dev": "turbo run dev",
    "format": "oxfmt -c oxfmt.config.ts --disable-nested-config . --write",
    "format:check": "oxfmt -c oxfmt.config.ts --disable-nested-config . --check",
    "knip": "knip",
    "lint": "oxlint -c oxlint.config.ts . --ignore-pattern \"packages/**\" --ignore-pattern \"examples/**\" && turbo run lint",
    "lint:fix": "oxlint -c oxlint.config.ts . --ignore-pattern \"packages/**\" --ignore-pattern \"examples/**\" --fix && turbo run lint:fix",
    "prepare": "simple-git-hooks",
    "release": "pnpm check && changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
